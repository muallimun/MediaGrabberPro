{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "30.1.0",
  "description": "__MSG_appDesc__",
  "default_locale": "tr",
  "browser_specific_settings": {
    "gecko": {
      "id": "mediagrabberpro@muallimun.net",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": ["jszip.min.js", "background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_appName__"
  },
  "permissions": [
    "webRequest",
    "storage",
    "downloads",
    "activeTab",
    "scripting",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "MacCtrl+Shift+Y"
      },
      "description": "Açılır menüyü aç"
    },
    "scan_page": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "MacCtrl+Shift+S"
      },
      "description": "Sayfadaki medyaları tara"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}