  "helpSec1Title": { "message": "🎯 Overview" },
  "helpSec1Desc": { "message": "Universal Media Grabber automatically captures audio, video, and documents on websites you visit. It intelligently names and downloads media from interactive learning platforms (SCORM) and popular media sites." },
  "helpSec2Title": { "message": "✨ Smart Naming" },
  "helpSec2Desc": { "message": "When adding media, it extracts labels like 'Artist', 'Song', 'Title' and saves the file as 'Artist - Song.mp3'. It automatically converts non-English characters to English equivalents." },
  "helpSec3Title": { "message": "🛡️ Site Rules" },
  "helpSec3Desc": { "message": "Use the 'For this site' menu at the top to set specific rules for each website. For example, on a news site, you can capture only audio and skip unnecessary videos." },
  "helpSec4Title": { "message": "⌨️ Shortcuts & Menus" },
  "helpSec4Desc": { "message": "Use keyboard shortcuts for quick actions: Ctrl+Shift+Y (Mac: Cmd+Shift+Y) opens the popup, Ctrl+Shift+S (Mac: Cmd+Shift+S) scans the current page. You can also right-click on a page and select 'Scan Page' from the 'Universal Media Grabber' menu." },
  "helpSec5Title": { "message": "📁 Ad Shield & Downloading" },
  "helpSec5Desc": { "message": "Filter out unwanted media with Ad Shield. Use the 3-dot (⋮) menu to block specific files or sites completely." },
